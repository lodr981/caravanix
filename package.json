    "design:screenshoty": "node tools/design/screenshoty.mjs",
    "og": "node tools/og.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
