---
// Společný rámec stránek kalkulaček alfy: štítek zkušební verze, nadpis, úvod, ostrůvek (slot) a „jak na to“.
import Zaklad from "./Zaklad.astro";
import { Notice } from "@caravanix/ui";
import t from "../../../../content/cs/kalkulacky-alfa.json";

interface Props {
  prefix: string;
  jakNaTo?: string[];
}
const { prefix, jakNaTo = [] } = Astro.props;
const k = (x: string) => (t as Record<string, string>)[`${prefix}.${x}`] ?? "";
---

<Zaklad title={k("title")} description={k("description")} noindex>
  <section class="cx-wrap kalk-uvod">
    <Notice kind="warn" word={t["spol.draftWord"]}>
      <p>{t["spol.draftText"]}</p>
    </Notice>
    <h1>{k("h1")}</h1>
    <p class="cx-lead cx-muted">{k("lead")}</p>
  </section>
  <section class="cx-wrap kalk-telo">
    <slot />
  </section>
  {
    jakNaTo.length > 0 && (
      <section class="cx-wrap kalk-dalsi">
        <h2>{t["spol.jakNaTo"]}</h2>
        <ul>
          {jakNaTo.map((x) => (
            <li>{x}</li>
          ))}
        </ul>
      </section>
    )
  }
</Zaklad>

<style is:global>
  .kalk-uvod {
    padding-block: var(--cx-space-7) var(--cx-space-5);
  }
  .kalk-uvod h1 {
    margin-block: var(--cx-space-5) var(--cx-space-3);
  }
  .kalk-telo {
    padding-bottom: var(--cx-space-7);
  }
  .kalk,
  .kalk-blok {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-5);
  }
  .kalk {
    gap: var(--cx-space-7);
    max-width: 52rem;
  }
  .kalk-blok h2 {
    margin: 0;
  }
  .kalk-mrizka {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-5);
  }
  @media (min-width: 720px) {
    .kalk-mrizka {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
  .kalk-seznam {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-4);
  }
  .kalk-polozka {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-4);
    padding: var(--cx-space-4);
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-md);
    background: var(--cx-surface);
  }
  /* Název spotřebiče: textové pole přes celou šířku sloupce (ne 8 znaků jako číslo). */
  .kalk-polozka .cx-input:has(input[type="text"]) {
    display: flex;
    width: 100%;
    max-width: 24rem;
  }
  .kalk-polozka input[type="text"] {
    width: 100%;
  }
  .kalk-polozka > .cx-btn {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .kalk-polozka {
      grid-template-columns: 1.4fr 1fr 1fr;
      align-items: start;
    }
    .kalk-polozka > .kalk-check {
      grid-column: 1 / 3;
    }
    .kalk-polozka > .cx-btn {
      grid-column: 3;
      justify-self: end;
    }
  }
  .kalk-check {
    display: flex;
    gap: var(--cx-space-3);
    align-items: center;
    min-height: var(--cx-tap);
    cursor: pointer;
  }
  .kalk-check input {
    flex: none;
    width: 24px;
    height: 24px;
    margin: 0;
    accent-color: var(--cx-accent);
  }
  /* Graf průběhu baterie: osa 100 / 50 / 0 %, mřížka a dny pod grafem. Prázdná baterie = nízký sloupec barvou bloku. */
  .kalk-graf-ram {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--cx-space-2) var(--cx-space-3);
  }
  .kalk-graf__osa {
    position: relative;
    height: 176px;
    min-width: 3.2em;
    font-size: var(--cx-fs-small);
    color: var(--cx-muted);
    font-variant-numeric: tabular-nums;
  }
  .kalk-graf__osa span {
    position: absolute;
    right: 0;
    line-height: 1;
    white-space: nowrap;
    transform: translateY(-50%);
  }
  .kalk-graf {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 176px;
    padding: var(--cx-space-2);
    border: 1px solid var(--cx-border);
    border-radius: var(--cx-radius-md);
    background-color: var(--cx-surface);
    background-image:
      linear-gradient(var(--cx-line), var(--cx-line)),
      linear-gradient(var(--cx-line), var(--cx-line)),
      linear-gradient(var(--cx-line), var(--cx-line));
    background-size: calc(100% - 2 * var(--cx-space-2)) 1px;
    background-position:
      center 25%,
      center 50%,
      center 75%;
    background-repeat: no-repeat;
  }
  .kalk-graf__sloupec {
    flex: 1;
    min-width: 1px;
    height: var(--v, 0%);
    background: linear-gradient(to top, var(--cx-accent), var(--cx-copper));
    border-radius: 3px 3px 0 0;
    transition: height var(--cx-motion-base) var(--cx-ease);
  }
  .kalk-graf__sloupec--nizko {
    background: var(--cx-warn-fg);
  }
  .kalk-graf__dny span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .kalk-graf__dny span:first-child {
    transform: none;
    left: 0 !important;
  }
  .kalk-graf__dny span:last-child:not(:first-child) {
    transform: translateX(-100%);
    left: 100% !important;
  }
  @media (max-width: 400px) {
    .kalk-graf {
      gap: 1px;
      padding-inline: 4px;
    }
  }
  .kalk-graf__sloupec--prazdna {
    height: 6px !important;
    background: var(--cx-block-fg);
    border-radius: 0;
  }
  .kalk-graf__dny {
    grid-column: 2;
    position: relative;
    height: 1.6em;
    font-size: var(--cx-fs-small);
    color: var(--cx-muted);
    font-variant-numeric: tabular-nums;
  }
  .kalk-mesice {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2px;
  }
  .kalk-mesice li {
    display: grid;
    grid-template-columns: 6.5em minmax(4rem, 1fr) auto;
    grid-template-areas: "mesic osa hodnota" "mesic osa slovo";
    align-items: center;
    gap: 0 var(--cx-space-3);
    padding: var(--cx-space-2) var(--cx-space-3);
    border-radius: var(--cx-radius-sm);
    background: var(--cx-surface);
  }
  @media (min-width: 720px) {
    .kalk-mesice li {
      grid-template-columns: 7em minmax(8rem, 1fr) 7.5em 8.5em;
      grid-template-areas: "mesic osa hodnota slovo";
    }
  }
  @media (max-width: 26rem) {
    .kalk-mesice li {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "mesic hodnota" "osa osa" "slovo slovo";
      gap: var(--cx-space-1) var(--cx-space-2);
    }
    .kalk-mesice__slovo {
      text-align: left;
    }
  }
  .kalk-mesice__mesic {
    grid-area: mesic;
  }
  .kalk-mesice__osa {
    grid-area: osa;
    position: relative;
    height: 0.75rem;
    border-radius: var(--cx-radius-pill);
    background: var(--cx-surface2);
  }
  /* středová osa = nula; přebytek roste doprava, schodek doleva */
  .kalk-mesice__osa::before {
    content: "";
    position: absolute;
    left: 50%;
    top: -0.25rem;
    bottom: -0.25rem;
    width: 2px;
    margin-left: -1px;
    background: var(--cx-border);
  }
  .kalk-mesice__osa i {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--w, 0%);
    transition: width var(--cx-motion-base) var(--cx-ease);
  }
  .kalk-mesice--plus .kalk-mesice__osa i {
    left: 50%;
    border-radius: 0 var(--cx-radius-pill) var(--cx-radius-pill) 0;
    background: var(--cx-ok-fg);
  }
  .kalk-mesice--minus .kalk-mesice__osa i {
    right: 50%;
    border-radius: var(--cx-radius-pill) 0 0 var(--cx-radius-pill);
    background: var(--cx-warn-fg);
  }
  .kalk-mesice__hodnota {
    grid-area: hodnota;
    text-align: right;
    white-space: nowrap;
  }
  .kalk-mesice__slovo {
    grid-area: slovo;
    text-align: right;
    font-size: var(--cx-fs-small);
    color: var(--cx-muted);
  }
  @media (min-width: 720px) {
    .kalk-mesice__slovo {
      text-align: left;
    }
  }
  .kalk-mesice--minus .kalk-mesice__slovo {
    color: var(--cx-warn-fg);
    font-weight: 600;
  }
  .kalk-pomoc {
    padding-left: 1.4em;
    display: grid;
    gap: var(--cx-space-2);
  }
  .kalk-dalsi {
    padding-bottom: var(--cx-space-8);
    max-width: 52rem;
  }
  .kalk-predpoklady {
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-md);
    padding: var(--cx-space-3) var(--cx-space-4);
    background: var(--cx-surface);
  }
  .kalk-predpoklady summary {
    min-height: var(--cx-tap);
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
  }
  .kalk-predpoklady[open] > .kalk-mrizka {
    margin-top: var(--cx-space-4);
  }
  .kalk-mesice li.kalk-mesice--zvoleny {
    outline: 2px solid var(--cx-accent);
    outline-offset: -2px;
    background: var(--cx-copper-soft);
    font-weight: 600;
  }
  /* posuvník a pole pro přesné číslo jako jedna veličina */
  .kalk-posuvnik {
    display: grid;
    align-content: start;
    gap: var(--cx-space-2);
    min-width: 0;
    padding: var(--cx-space-4);
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-md);
    background: var(--cx-surface);
  }
  /* stejně široká tlačítka − / +, aby posuvníky v mřížce měly stejnou délku */
  .kalk-posuvnik .cx-slider__step {
    min-width: 4.25rem;
  }
  .kalk-posuvnik .cx-label {
    font-weight: 600;
  }
  .kalk-posuvnik .cx-field .cx-label {
    font-weight: 400;
    color: var(--cx-muted);
    font-size: var(--cx-fs-small);
  }
  .kalk-mrizka--posuvniky {
    gap: var(--cx-space-4);
  }
  /* na velmi úzkém okně (nebo při velkém zvětšení) bez rámečku, aby pole mělo celou šířku */
  @media (max-width: 20rem) {
    .kalk-posuvnik {
      padding: 0;
      border: 0;
      background: none;
    }
  }
  /* posuvníky vedle sebe až tam, kde má každý dost délky; na tabletu pod sebou */
  @media (min-width: 720px) and (max-width: 1099px) {
    .kalk-mrizka--posuvniky {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .kalk-mrizka--posuvniky {
      align-items: stretch;
    }
  }
  /* vizualizace pod displejem výsledku: nádrž vedle pruhů */
  .kalk-vizual {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-5);
    align-items: end;
  }
  @media (min-width: 640px) {
    .kalk-vizual {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
  /* schéma pole panelů: řádek = větev, ikona = panel */
  .kalk-pole {
    justify-items: start;
    margin: 0;
    display: grid;
    gap: var(--cx-space-2);
  }
  .kalk-pole__mrizka {
    display: grid;
    gap: var(--cx-space-2);
    justify-content: start;
    padding: var(--cx-space-3);
    border: 1px dashed var(--cx-border);
    border-radius: var(--cx-radius-md);
    background: var(--cx-surface);
  }
  .kalk-pole__vetev {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .kalk-pole__panel {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--cx-radius-sm);
    background: var(--cx-copper-soft);
    color: var(--cx-accent-text);
  }
  .kalk-polozka__nazev {
    display: inline-flex;
    align-items: center;
    gap: var(--cx-space-2);
  }
  .kalk-polozka__ikona {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--cx-surface2);
    color: var(--cx-accent-text);
  }
</style>
