---
// Společný rámec stránek kalkulaček alfy: štítek zkušební verze, nadpis, úvod, ostrůvek (slot) a „jak na to“.
import Zaklad from "./Zaklad.astro";
import { Notice } from "@caravanix/ui";
import t from "../../../../content/cs/kalkulacky-alfa.json";

interface Props {
  prefix: string;
  jakNaTo?: string[];
}
const { prefix, jakNaTo = [] } = Astro.props;
const k = (x: string) => (t as Record<string, string>)[`${prefix}.${x}`] ?? "";
---

<Zaklad title={k("title")} description={k("description")} noindex>
  <section class="cx-wrap kalk-uvod">
    <Notice kind="warn" word={t["spol.draftWord"]}>
      <p>{t["spol.draftText"]}</p>
    </Notice>
    <h1>{k("h1")}</h1>
    <p class="cx-lead cx-muted">{k("lead")}</p>
  </section>
  <section class="cx-wrap kalk-telo">
    <slot />
  </section>
  {
    jakNaTo.length > 0 && (
      <section class="cx-wrap kalk-dalsi">
        <h2>{t["spol.jakNaTo"]}</h2>
        <ul>
          {jakNaTo.map((x) => (
            <li>{x}</li>
          ))}
        </ul>
      </section>
    )
  }
</Zaklad>

<style is:global>
  .kalk-uvod {
    padding-block: var(--cx-space-7) var(--cx-space-5);
  }
  .kalk-uvod h1 {
    margin-block: var(--cx-space-5) var(--cx-space-3);
  }
  .kalk-telo {
    padding-bottom: var(--cx-space-7);
  }
  .kalk,
  .kalk-blok {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-5);
  }
  .kalk {
    gap: var(--cx-space-7);
    max-width: 52rem;
  }
  .kalk-blok h2 {
    margin: 0;
  }
  .kalk-mrizka {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-5);
  }
  @media (min-width: 720px) {
    .kalk-mrizka {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }
  .kalk-seznam {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-4);
  }
  .kalk-polozka {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-4);
    padding: var(--cx-space-4);
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-md);
    background: var(--cx-surface);
  }
  /* Název spotřebiče: textové pole přes celou šířku sloupce (ne 8 znaků jako číslo). */
  .kalk-polozka .cx-input:has(input[type="text"]) {
    display: flex;
    width: 100%;
    max-width: 24rem;
  }
  .kalk-polozka input[type="text"] {
    width: 100%;
  }
  .kalk-polozka > .cx-btn {
    justify-self: start;
  }
  @media (min-width: 900px) {
    .kalk-polozka {
      grid-template-columns: 1.4fr 1fr 1fr;
      align-items: start;
    }
    .kalk-polozka > .kalk-check {
      grid-column: 1 / 3;
    }
    .kalk-polozka > .cx-btn {
      grid-column: 3;
      justify-self: end;
    }
  }
  .kalk-check {
    display: flex;
    gap: var(--cx-space-3);
    align-items: center;
    min-height: var(--cx-tap);
    cursor: pointer;
  }
  .kalk-check input {
    flex: none;
    width: 24px;
    height: 24px;
    margin: 0;
    accent-color: var(--cx-accent);
  }
  /* Graf průběhu baterie: osa 100 / 50 / 0 %, mřížka a dny pod grafem. Prázdná baterie = nízký sloupec barvou bloku. */
  .kalk-graf-ram {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--cx-space-2) var(--cx-space-3);
  }
  .kalk-graf__osa {
    position: relative;
    height: 176px;
    min-width: 3.2em;
    font-size: var(--cx-fs-small);
    color: var(--cx-muted);
    font-variant-numeric: tabular-nums;
  }
  .kalk-graf__osa span {
    position: absolute;
    right: 0;
    line-height: 1;
    white-space: nowrap;
    transform: translateY(-50%);
  }
  .kalk-graf {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 176px;
    padding: var(--cx-space-2);
    border: 1px solid var(--cx-border);
    border-radius: var(--cx-radius-md);
    background-color: var(--cx-surface);
    background-image: linear-gradient(var(--cx-line), var(--cx-line));
    background-size: calc(100% - 2 * var(--cx-space-2)) 1px;
    background-position: center;
    background-repeat: no-repeat;
  }
  .kalk-graf__sloupec {
    flex: 1;
    min-width: 1px;
    background: var(--cx-copper);
    border-radius: 2px 2px 0 0;
  }
  .kalk-graf__dny span:last-child {
    margin-left: auto;
  }
  @media (max-width: 400px) {
    .kalk-graf {
      gap: 1px;
      padding-inline: 4px;
    }
  }
  .kalk-graf__sloupec--prazdna {
    height: 6px !important;
    background: var(--cx-block-fg);
    border-radius: 0;
  }
  .kalk-graf__dny {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--cx-space-3);
    font-size: var(--cx-fs-small);
    color: var(--cx-muted);
    font-variant-numeric: tabular-nums;
  }
  .kalk-mesice {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--cx-space-2);
  }
  @media (min-width: 720px) {
    .kalk-mesice {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .kalk-mesice li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 var(--cx-space-3);
    padding: var(--cx-space-2) var(--cx-space-3);
    border-left: 4px solid var(--cx-ok-fg);
    background: var(--cx-surface);
  }
  .kalk-mesice li.kalk-mesice--minus {
    border-left-color: var(--cx-warn-fg);
  }
  .kalk-mesice .cx-hint {
    flex-basis: 100%;
  }
  .kalk-pomoc {
    padding-left: 1.4em;
    display: grid;
    gap: var(--cx-space-2);
  }
  .kalk-dalsi {
    padding-bottom: var(--cx-space-8);
    max-width: 52rem;
  }
  .kalk-predpoklady {
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-md);
    padding: var(--cx-space-3) var(--cx-space-4);
    background: var(--cx-surface);
  }
  .kalk-predpoklady summary {
    min-height: var(--cx-tap);
    display: flex;
    align-items: center;
    cursor: pointer;
    font-weight: 600;
  }
  .kalk-predpoklady[open] > .kalk-mrizka {
    margin-top: var(--cx-space-4);
  }
  .kalk-mesice li.kalk-mesice--zvoleny {
    outline: 2px solid var(--cx-accent);
    outline-offset: -2px;
    font-weight: 600;
  }
</style>
