---
// Základní layout všech stránek: písmo, tokeny a styl z @caravanix/ui, hlavička s přepínačem režimu, patička.
// Režim se nastaví inline skriptem v <head> ještě před vykreslením (žádné bliknutí špatného režimu).
// Hlavička a patička jsou React komponenty vykreslené na serveru, bez hydratace.
import "@caravanix/ui/styles.css";
import { SiteFooter, SiteHeader, themeInitScript, color, type NavItem } from "@caravanix/ui";
import t from "../../../../content/cs/web.json";

interface Props {
  title: string;
  description?: string;
  nav?: NavItem[];
  /** Stránka se nemá indexovat (interní ukázky). */
  noindex?: boolean;
  /** Upozornění „podklad, ne revize“ v patičce. Na stránkách s výpočtem povinné; výchozí zapnuto. */
  notice?: boolean;
}

const { title, description, noindex = false, notice = true } = Astro.props;
// Náhled odkazu (og:image): karta výsledku s typickým příkladem, vyrobená skriptem tools/og.mjs.
const OG_STRANKY = ["kalkulacka-sobestacnosti", "kalkulacka-baterie", "kalkulacka-spotrebicu", "kalkulacka-boosteru", "kalkulacka-menice", "kalkulacka-solaru", "kalkulacka-prurezu"];
const slug = Astro.url.pathname.split("/").filter(Boolean)[1] ?? "";
const ogObrazek = OG_STRANKY.includes(slug) ? `/og/${slug}.png` : "/og/kalkulacka-sobestacnosti.png";
// Stejná navigace na všech stránkách (dřív jen na úvodu); aktuální stránka má aria-current.
const nav: NavItem[] = (Astro.props.nav ?? [
  { href: "/cs/#kalkulacky", label: t["nav.kalkulacky"] },
  { href: "/cs/zapojeni/", label: t["nav.zapojeni"] },
  { href: "/cs/spotrebice/", label: t["nav.spotrebice"] },
  { href: "/cs/#prirucka", label: t["nav.prirucka"] },
]).map((n) => ({
  ...n,
  current: n.current ?? Astro.url.pathname === n.href,
}));
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={color.light.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={color.dark.bg} media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Caravanix" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {ogObrazek && <meta property="og:image" content={new URL(ogObrazek, Astro.site ?? Astro.url).href} />}
    {ogObrazek && <meta property="og:image:width" content="1200" />}
    {ogObrazek && <meta property="og:image:height" content="630" />}
    {ogObrazek && <meta name="twitter:card" content="summary_large_image" />}
    <title>{title}</title>
    <script is:inline set:html={themeInitScript} />
  </head>
  <body>
    <SiteHeader
      brand={t["site.name"]}
      brandHref="/cs/"
      brandLabel={t["header.brandLabel"]}
      nav={nav}
      navLabel={t["header.navLabel"]}
      theme={{ toDark: t["theme.toDark"], toLight: t["theme.toLight"] }}
      skip={{ href: "#obsah", label: t["a11y.skip"] }}
    />
    <main id="obsah" tabindex="-1">
      <slot />
    </main>
    <SiteFooter notice={notice ? t["footer.notice"] : undefined} meta={t["footer.meta"]} />
  </body>
</html>
