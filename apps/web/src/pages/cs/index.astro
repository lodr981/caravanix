---
// Úvodní stránka interní alfy: rozcestník na hotové kalkulačky. Vzor hlavní stránky přijde od designéra.
import Zaklad from "../../layouts/Zaklad.astro";
import { Notice } from "@caravanix/ui";
import { getCollection } from "astro:content";

const lekce = (await getCollection("lekceCs")).sort((a, b) => a.data.poradi - b.data.poradi);
import t from "../../../../../content/cs/web.json";
---

<Zaklad title={t["home.title"]} description={t["home.lead"]} noindex>
  <section class="cx-wrap uvod">
    <Notice kind="warn" word={t["home.draftWord"]}>
      <p>{t["home.draftText"]}</p>
    </Notice>
    <h1>{t["site.name"]}</h1>
    <p class="cx-lead cx-muted">{t["home.lead"]}</p>
  </section>
  <section class="cx-wrap kalkulacky" id="kalkulacky">
    <h2>{t["home.calcH2"]}</h2>
    <div class="karty">
      {
        t["home.kalk"].map((k) => (
          <article class="karta">
            <h3>{k.nazev}</h3>
            <p>{k.text}</p>
            <a class="cx-btn cx-btn--primary" href={k.href}>
              <span>{k.tlacitko}</span>
            </a>
          </article>
        ))
      }
    </div>
  </section>
  <section class="cx-wrap prirucka" id="prirucka">
    <h2>{t["home.lekceH2"]}</h2>
    <ul class="cx-linklist">
      {
        lekce.map((l) => (
          <li>
            <a class="cx-linklist__link" href={`/cs/lekce/${l.id}/`}>{l.data.titulek}</a>
            <p class="cx-linklist__text">{l.data.zasada}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Zaklad>

<style>
  .karty {
    display: grid;
    gap: var(--cx-space-4);
  }
  @media (min-width: 720px) {
    .karty {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .uvod {
    padding-block: var(--cx-space-7) var(--cx-space-5);
  }
  .uvod h1 {
    margin-block: var(--cx-space-5) var(--cx-space-4);
  }
  .kalkulacky,
  .prirucka {
    padding-block: var(--cx-space-5);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-4);
  }
  .prirucka {
    padding-bottom: var(--cx-space-8);
  }
  .karta {
    max-width: 40rem;
    background: var(--cx-surface);
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-lg);
    padding: var(--cx-space-5);
    display: grid;
    gap: var(--cx-space-3);
    justify-items: start;
  }
</style>
