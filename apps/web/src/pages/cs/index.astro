---
// Úvodní stránka interní alfy: rozcestník na hotové kalkulačky. Hlavní kalkulačka (soběstačnost, první v seznamu) má výraznou kartu.
import Zaklad from "../../layouts/Zaklad.astro";
import { IconArrowRight, IconBattery, IconCable, IconBolt, IconFuse, IconInverter, IconPlug, IconSolarPanel, IconSun, IconVan, Notice } from "@caravanix/ui";
import { getCollection } from "astro:content";

const lekce = (await getCollection("lekceCs")).sort((a, b) => a.data.poradi - b.data.poradi);
import t from "../../../../../content/cs/web.json";
import ts from "../../../../../content/cs/schema.json";
import tr from "../../../../../content/cs/rez-dodavkou.json";
import tc from "../../../../../content/cs/cesta.json";
import tz from "../../../../../content/cs/zapojeni.json";
import { RezDodavkou } from "../../components/RezDodavkou.tsx";
import { sobestacnost } from "@caravanix/engine";
import { solarMesta } from "@caravanix/data";

// Hlavní obrázek: řez dodávkou napojený na výchozí příklad kalkulačky soběstačnosti (počítá engine).
const priklad = { mesto: "praha", mesic: 7, panelyWp: 200, kapacitaAh: 200, napeti: 12, WhDenne: 800 } as const;
const rezVysledek = sobestacnost(priklad);
const rezPriklad = tr["uvod.priklad"]
  .replace("{mesto}", solarMesta.mesta.find((m) => m.id === priklad.mesto)?.nazev ?? priklad.mesto)
  .replace("{mesic}", new Date(2026, priklad.mesic - 1, 1).toLocaleString("cs-CZ", { month: "long" }))
  .replace("{wp}", String(priklad.panelyWp))
  .replace("{ah}", String(priklad.kapacitaAh))
  .replace("{wh}", String(priklad.WhDenne));

// Ikona karty podle adresy kalkulačky (vlastní SVG z @caravanix/ui, vždy vedle názvu).
const IKONY: Record<string, typeof IconBattery> = {
  "/cs/kalkulacka-sobestacnosti/": IconVan,
  "/cs/kalkulacka-spotrebicu/": IconPlug,
  "/cs/kalkulacka-baterie/": IconBattery,
  "/cs/kalkulacka-solaru/": IconSolarPanel,
  "/cs/kalkulacka-boosteru/": IconBolt,
  "/cs/kalkulacka-menice/": IconInverter,
  "/cs/kalkulacka-prurezu/": IconCable,
};
const [hlavni, ...ostatni] = t["home.kalk"];
const HlavniIkona = IKONY[hlavni.href] ?? IconVan;
const stitek = (t as Record<string, unknown>)["home.hlavniStitek"] as string | undefined;
---

<Zaklad title={t["home.title"]} description={t["home.lead"]} noindex>
  <section class="cx-wrap uvod">
    <Notice kind="warn" word={t["home.draftWord"]}>
      <p>{t["home.draftText"]}</p>
    </Notice>
    <h1>{t["site.name"]}</h1>
    <p class="cx-lead cx-muted">{t["home.lead"]}</p>
    <figure class="rez-uvod">
      <RezDodavkou client:load t={tr} vysledek={rezVysledek.stav === "ok" ? rezVysledek : null} priklad={rezPriklad} />
      <figcaption>
        <a class="cx-btn cx-btn--primary" href="/cs/kalkulacka-sobestacnosti/">
          <span>{tr["uvod.odkaz"]}</span>
          <IconArrowRight className="cx-icon" />
        </a>
      </figcaption>
    </figure>
  </section>
  <section class="cx-wrap postup" id="postup" aria-labelledby="postup-h">
    <div class="postup__hlava">
      <picture class="postup__maskot">
        <source srcset="/obrazky/maskot/v2-600.webp" type="image/webp" />
        <img src="/obrazky/maskot/v2-600.webp" alt={tc.maskotAlt} width="600" height="454" decoding="async" />
      </picture>
      <div>
        <h2 id="postup-h">{tc["uvod.h2"]}</h2>
        <p class="cx-lead cx-muted">{tc["uvod.lead"]}</p>
        <div class="cx-btns">
          <a class="cx-btn cx-btn--primary" href={tc.kroky[0]!.href}>
            <span>{tc["uvod.start"]}</span>
            <IconArrowRight className="cx-icon" />
          </a>
          <a class="cx-btn cx-btn--secondary" href="/cs/zapojeni/">
            <span>{tc["uvod.zapojeni"]}</span>
          </a>
        </div>
      </div>
    </div>
    <ol class="postup__kroky">
      {
        tc.kroky.map((k, i) => (
          <li>
            <a class="postup__krok" href={k.href}>
              <span class="postup__cislo">{i + 1}</span>
              <span class="postup__text">
                <strong>{k.nazev}</strong>
                <span class="cx-muted">{k.otazka}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>
  <section class="cx-wrap kalkulacky" id="kalkulacky">
    <h2>{t["home.calcH2"]}</h2>
    <article class="hlavni">
      <div class="hlavni__text">
        {stitek && <p class="hlavni__stitek">{stitek}</p>}
        <h3 class="hlavni__nazev">
          <span class="ikona ikona--velka"><HlavniIkona className="cx-icon" /></span>
          <span>{hlavni.nazev}</span>
        </h3>
        <p class="hlavni__popis">{hlavni.text}</p>
        <a class="cx-btn cx-btn--primary" href={hlavni.href}>
          <span>{hlavni.tlacitko}</span>
          <IconArrowRight className="cx-icon" />
        </a>
      </div>
      <div class="hlavni__displej" aria-hidden="true">
        <span class="tok"><IconSun className="cx-icon" /></span>
        <i class="tok__cara"></i>
        <span class="tok"><IconSolarPanel className="cx-icon" /></span>
        <i class="tok__cara"></i>
        <span class="tok tok--baterie"><span class="tok__hladina"></span></span>
        <i class="tok__cara"></i>
        <span class="tok"><IconVan className="cx-icon" /></span>
      </div>
    </article>
    <div class="karty">
      {
        ostatni.map((k) => {
          const I = IKONY[k.href] ?? IconPlug;
          return (
            <article class="karta">
              <h3 class="karta__nazev">
                <span class="ikona">
                  <I className="cx-icon" />
                </span>
                <span>{k.nazev}</span>
              </h3>
              <p>{k.text}</p>
              <a class="cx-btn cx-btn--secondary" href={k.href}>
                <span>{k.tlacitko}</span>
              </a>
            </article>
          );
        })
      }
      <article class="karta">
        <h3 class="karta__nazev">
          <span class="ikona">
            <IconCable className="cx-icon" />
          </span>
          <span>{tz["karta.nazev"]}</span>
        </h3>
        <p>{tz["karta.text"]}</p>
        <a class="cx-btn cx-btn--secondary" href="/cs/zapojeni/">
          <span>{tz["karta.tlacitko"]}</span>
        </a>
      </article>
      <article class="karta">
        <h3 class="karta__nazev">
          <span class="ikona">
            <IconFuse className="cx-icon" />
          </span>
          <span>{ts["karta.nazev"]}</span>
        </h3>
        <p>{ts["karta.text"]}</p>
        <a class="cx-btn cx-btn--secondary" href="/cs/schema-r1/">
          <span>{ts["karta.tlacitko"]}</span>
        </a>
      </article>
    </div>
  </section>
  <section class="cx-wrap prirucka" id="prirucka">
    <h2>{t["home.lekceH2"]}</h2>
    <ul class="cx-linklist">
      {
        lekce.map((l) => (
          <li>
            <a class="cx-linklist__link" href={`/cs/lekce/${l.id}/`}>{l.data.titulek}</a>
            <p class="cx-linklist__text">{l.data.zasada}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Zaklad>

<style>
  .postup {
    padding-block: var(--cx-space-7);
    display: grid;
    gap: var(--cx-space-6);
  }
  .postup__hlava {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-5);
    align-items: center;
  }
  @media (min-width: 760px) {
    .postup__hlava {
      grid-template-columns: minmax(12rem, 22rem) minmax(0, 1fr);
    }
  }
  .postup__hlava h2 {
    margin: 0 0 var(--cx-space-3);
  }
  .postup__hlava .cx-lead {
    margin: 0 0 var(--cx-space-5);
    max-width: 40rem;
  }
  .postup__maskot img {
    display: block;
    width: 100%;
    max-width: 22rem;
    height: auto;
    border-radius: var(--cx-radius-md);
  }
  .postup__kroky {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--cx-space-3);
    counter-reset: none;
  }
  .postup__krok {
    display: flex;
    gap: var(--cx-space-3);
    align-items: flex-start;
    height: 100%;
    padding: var(--cx-space-4);
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-md);
    background: var(--cx-surface);
    color: var(--cx-text);
    text-decoration: none;
  }
  .postup__krok:hover {
    border-color: var(--cx-accent);
  }
  .postup__krok:hover strong {
    text-decoration: underline;
  }
  .postup__cislo {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    border-radius: 50%;
    background: var(--cx-accent);
    color: var(--cx-bg);
    font-weight: 700;
  }
  .postup__text {
    display: grid;
    gap: var(--cx-space-1);
  }
  .karty {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-4);
  }
  @media (min-width: 720px) {
    .karty {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .karty {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .uvod {
    padding-block: var(--cx-space-7) var(--cx-space-5);
  }
  .rez-uvod {
    margin: var(--cx-space-5) 0 0;
    display: grid;
    gap: var(--cx-space-4);
    justify-items: start;
  }
  @media (max-width: 26rem) {
    .rez-uvod .cx-btn :global(.cx-icon) {
      display: none;
    }
  }
  .uvod h1 {
    margin-block: var(--cx-space-5) var(--cx-space-4);
  }
  .kalkulacky,
  .prirucka {
    padding-block: var(--cx-space-5);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-4);
  }
  .prirucka {
    padding-bottom: var(--cx-space-8);
  }

  /* hlavní kalkulačka: větší karta s tmavým „displejem“ toku energie (slunce → panel → baterie → vůz) */
  .hlavni {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-5);
    padding: var(--cx-space-6);
    border: 2px solid var(--cx-accent);
    border-radius: var(--cx-radius-lg);
    background: var(--cx-surface);
    box-shadow: var(--cx-shadow-md);
  }
  @media (min-width: 860px) {
    .hlavni {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: center;
    }
  }
  .hlavni__text {
    display: grid;
    gap: var(--cx-space-3);
    justify-items: start;
  }
  .hlavni__text > * {
    margin: 0;
  }
  .hlavni__stitek {
    padding: 0.2rem 0.75rem;
    border-radius: var(--cx-radius-pill);
    background: var(--cx-copper-soft);
    color: var(--cx-text);
    font-size: var(--cx-fs-small);
    font-weight: 600;
  }
  @media (max-width: 26rem) {
    .hlavni {
      padding: var(--cx-space-4);
    }
    /* dekorativní tok energie se na velmi úzké okno nevejde, nic nesděluje: skrytý */
    .hlavni__displej {
      display: none;
    }
    .hlavni .cx-btn :global(.cx-icon) {
      display: none;
    }
  }
  .karta__nazev > span:last-child,
  .hlavni__nazev > span:last-child {
    min-width: 0;
    hyphens: auto;
    overflow-wrap: anywhere;
  }
  .hlavni__nazev {
    hyphens: auto;
    overflow-wrap: anywhere;
    display: flex;
    align-items: center;
    gap: var(--cx-space-3);
    font-size: var(--cx-fs-h2);
  }
  .hlavni__popis {
    font-size: var(--cx-fs-lead);
  }
  .hlavni__displej {
    display: flex;
    flex-wrap: wrap;
    row-gap: var(--cx-space-3);
    align-items: center;
    justify-content: center;
    gap: var(--cx-space-2);
    min-height: 9rem;
    padding: var(--cx-space-5);
    border: 1px solid var(--cx-display-border);
    border-radius: var(--cx-radius-md);
    background: var(--cx-display-bg);
    box-shadow: var(--cx-shadow-display);
    color: var(--cx-display-accent);
  }
  .tok {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--cx-display-muted);
  }
  .tok :global(.cx-icon) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .tok__cara {
    flex: 1 1 1rem;
    max-width: 3rem;
    height: 2px;
    background: repeating-linear-gradient(to right, var(--cx-display-accent) 0 6px, transparent 6px 10px);
  }
  .tok--baterie {
    position: relative;
    width: 2.4rem;
    height: 3.6rem;
    border-radius: 6px;
    border: 2px solid var(--cx-display-text);
    overflow: hidden;
  }
  .tok__hladina {
    position: absolute;
    inset: auto 3px 3px 3px;
    height: 70%;
    border-radius: 2px;
    background: var(--cx-display-accent);
  }

  .karta {
    background: var(--cx-surface);
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-lg);
    padding: var(--cx-space-5);
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--cx-space-3);
    justify-items: start;
    transition:
      border-color var(--cx-motion-fast) var(--cx-ease),
      box-shadow var(--cx-motion-fast) var(--cx-ease);
  }
  .karta:hover {
    border-color: var(--cx-border);
    box-shadow: var(--cx-shadow-sm);
  }
  .karta p,
  .karta h3 {
    margin: 0;
  }
  .karta__nazev {
    display: flex;
    align-items: center;
    gap: var(--cx-space-3);
  }
  .ikona {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--cx-copper-soft);
    color: var(--cx-accent-text);
  }
  .ikona--velka {
    width: 3.25rem;
    height: 3.25rem;
  }
</style>
