---
// Živé schéma na příkladu R1 (Vizuál 1, krok 3). Zkušební verze pro lokální alfu.
import Zaklad from "../../layouts/Zaklad.astro";
import { IconArrowRight, Notice } from "@caravanix/ui";
import { projektR1 } from "@caravanix/data";
import { ZiveSchema } from "../../components/ZiveSchema.tsx";
import t from "../../../../../content/cs/schema.json";
import ka from "../../../../../content/cs/kalkulacky-alfa.json";
---

<Zaklad title={t.title} description={t.description} noindex>
  <section class="cx-wrap sch-uvod">
    <Notice kind="warn" word={ka["spol.draftWord"]}>
      <p>{(t as Record<string, string>)["draftText"] ?? ka["spol.draftText"]}</p>
    </Notice>
    <h1>{t.h1}</h1>
    <p class="cx-lead cx-muted">{t.lead}</p>
    <p class="cx-muted">{projektR1.nazev}</p>
  </section>
  <section class="cx-wrap sch-telo">
    <ZiveSchema client:load t={t} />
  </section>
  <section class="cx-wrap sch-dole">
    <h2>{t["dole.h2"]}</h2>
    <p>{t["dole.text"]}</p>
    <p class="cx-muted">{projektR1.poznamka}</p>
    <a class="cx-btn cx-btn--secondary" href="/cs/kalkulacka-prurezu/">
      <span>{t["dole.odkaz"]}</span>
      <IconArrowRight className="cx-icon" />
    </a>
  </section>
</Zaklad>

<style>
  .sch-uvod {
    padding-block: var(--cx-space-7) var(--cx-space-5);
  }
  .sch-uvod h1 {
    margin-block: var(--cx-space-5) var(--cx-space-3);
  }
  .sch-telo {
    padding-bottom: var(--cx-space-6);
  }
  .sch-dole {
    padding-bottom: var(--cx-space-8);
    display: grid;
    justify-items: start;
    gap: var(--cx-space-3);
  }
  .sch-dole > * {
    margin: 0;
    max-width: 52rem;
  }
  @media (max-width: 26rem) {
    .sch-dole .cx-btn :global(.cx-icon) {
      display: none;
    }
  }
</style>
