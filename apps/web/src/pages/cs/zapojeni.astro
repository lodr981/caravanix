---
// Průvodce zapojením (docs/KALKULACKY_ALFA.md, kapitola H). Zkušební verze pro lokální alfu.
import Zaklad from "../../layouts/Zaklad.astro";
import Cesta from "../../components/cesta/Cesta.astro";
import { Notice } from "@caravanix/ui";
import { PruvodceZapojenim } from "../../components/PruvodceZapojenim.tsx";
import tz from "../../../../../content/cs/zapojeni.json";
import ka from "../../../../../content/cs/kalkulacky-alfa.json";
import ts from "../../../../../content/cs/schema.json";
import tb from "../../../../../content/cs/blokove-schema.json";

const t = { ...ka, ...tz } as Record<string, string>;
---

<Zaklad title={t.title!} description={t.description!} noindex>
  <section class="cx-wrap zap-uvod">
    <Notice kind="warn" word={ka["spol.draftWord"]}>
      <p>{ts["draftText"]}</p>
    </Notice>
    <Cesta pozice="nahore" />
    <h1>{t.h1}</h1>
    <p class="cx-lead cx-muted">{t.lead}</p>
  </section>
  <section class="cx-wrap zap-telo">
    <PruvodceZapojenim client:load t={t} ts={ts} tb={tb} />
  </section>
  <Cesta pozice="dole" />
</Zaklad>

<style>
  .zap-uvod {
    padding-block: var(--cx-space-7) var(--cx-space-5);
  }
  .zap-uvod h1 {
    margin-block: var(--cx-space-5) var(--cx-space-3);
  }
  .zap-uvod .cx-lead {
    max-width: 52rem;
  }
  .zap-telo {
    padding-bottom: var(--cx-space-7);
  }
</style>
