---
// INTERNÍ ukázková stránka komponent design systému. Před vydáním se odstraní (docs/design/KOMPONENTY.md).
// Má noindex a nevede na ni žádný odkaz. Čísla ve výsledku jsou ukázková data ze style tile, nic se nepočítá.
import Zaklad from "../../layouts/Zaklad.astro";
import { color, typography } from "@caravanix/ui";
import { OvladaniDemo, SdileniDemo, TabulkaUkazka, TlacitkaUkazka, VysledekUkazka } from "../../components/KomponentyDemo.tsx";
import t from "../../../../../content/cs/komponenty.json";
import w from "../../../../../content/cs/web.json";

const nav = [
  { href: "#barvy", label: t["nav.colors"] },
  { href: "#ovladani", label: t["nav.controls"] },
  { href: "#vysledek", label: t["nav.result"] },
  { href: "#tabulka", label: t["nav.table"] },
  { href: "#sdileni", label: t["nav.share"] },
];

// Barevné vzorky: světlý i tmavý režim vedle sebe, hodnoty přímo z tokenů.
const chips = ["bg", "surface", "surface2", "text", "muted", "accent", "accentText", "copper", "displayBg", "displayAccent"] as const;

// Velikost písma v px pro danou šířku okna: vyhodnotí rem nebo clamp(a rem, b rem + c vw, d rem).
function px(value: string, vw: number) {
  const root = vw >= 1024 ? 20 : 18;
  const m = value.match(/clamp\(([\d.]+)rem,\s*([\d.]+)rem \+ ([\d.]+)vw,\s*([\d.]+)rem\)/);
  if (m) {
    const [, a, b, c, d] = m.map(Number) as number[];
    return Math.min(d! * root, Math.max(a! * root, b! * root + (c! * vw) / 100));
  }
  return parseFloat(value) * root;
}
const fmtPx = (n: number) => `${n.toLocaleString("cs-CZ", { maximumFractionDigits: 1 })} px`;
const levels = [
  ["display", 700],
  ["h1", 700],
  ["h2", 600],
  ["h3", 600],
  ["lead", 400],
  ["body", 400],
  ["small", 400],
  ["foot", 400],
] as const;
const typeRows = levels.map(([k, wgt]) => ({
  level: t[`type.level.${k}` as keyof typeof t],
  mobile: fmtPx(px(typography.size[k], 360)),
  desktop: fmtPx(px(typography.size[k], 1280)),
  weight: String(wgt),
}));
---

<Zaklad title={t.title} nav={nav} noindex>
  <div class="cx-wrap demo">
    <header class="demo-intro">
      <p class="demo-kicker">{t.kicker}</p>
      <h1>{t.title}</h1>
      <p class="cx-lead cx-muted">{t.lead}</p>
    </header>

    <section id="barvy" class="demo-sec" aria-labelledby="barvy-h">
      <h2 id="barvy-h">{t["colors.title"]}</h2>
      <p class="cx-muted">{t["colors.lead"]}</p>
      <ul class="chips">
        {
          chips.map((c) => (
            <li class="chip">
              <span class="chip__sw" aria-hidden="true">
                <i style={`background:${color.light[c]}`} />
                <i style={`background:${color.dark[c]}`} />
              </span>
              <span class="chip__name">{t[`colors.chip.${c}` as keyof typeof t]}</span>
              <span class="chip__hex cx-num">
                {color.light[c]} / {color.dark[c]}
              </span>
            </li>
          ))
        }
      </ul>
      <p>
        <a href="#barvy">{t["colors.link"]}</a>
        {t["colors.linkRest"]}
      </p>

      <h3 class="demo-h3">{t["buttons.title"]}</h3>
      <TlacitkaUkazka t={t} />
    </section>

    <section id="ovladani" class="demo-sec" aria-labelledby="ovladani-h">
      <h2 id="ovladani-h">{t["controls.title"]}</h2>
      <p class="cx-muted">{t["controls.lead"]}</p>
      <div class="demo-panel">
        <OvladaniDemo client:visible t={t} />
      </div>
    </section>

    <section id="vysledek" class="demo-sec" aria-labelledby="vysledek-h">
      <h2 id="vysledek-h" class="cx-visually-hidden">{t["nav.result"]}</h2>
      <VysledekUkazka t={t} />
    </section>

    <section id="tabulka" class="demo-sec" aria-labelledby="tabulka-h">
      <h2 id="tabulka-h">{t["nav.table"]}</h2>
      <TabulkaUkazka t={t} rows={typeRows} />
    </section>

    <section id="sdileni" class="demo-sec" aria-labelledby="sdileni-h">
      <h2 id="sdileni-h">{t["share.title"]}</h2>
      <p class="cx-muted">{t["share.lead"]}</p>
      <SdileniDemo client:visible t={t} brand={w["site.name"]} />
    </section>

    <section class="demo-sec" aria-labelledby="ramec-h">
      <h2 id="ramec-h">{t["chrome.title"]}</h2>
      <p class="cx-muted">{t["chrome.lead"]}</p>
    </section>
  </div>
</Zaklad>

<style>
  .demo {
    padding-top: var(--cx-space-7);
  }
  .demo-intro {
    max-width: 44rem;
    margin-bottom: var(--cx-space-6);
  }
  .demo-intro h1 {
    margin-bottom: var(--cx-space-4);
  }
  .demo-kicker {
    margin: 0 0 var(--cx-space-3);
    color: var(--cx-accent-text);
    font-size: var(--cx-fs-small);
    font-weight: 600;
  }
  .demo-sec {
    padding-block: var(--cx-space-7);
    border-top: 1px solid var(--cx-line);
  }
  .demo-sec > h2 {
    margin-bottom: var(--cx-space-3);
  }
  .demo-h3 {
    margin: var(--cx-space-6) 0 var(--cx-space-4);
  }
  .demo :global(.demo-h3--top) {
    margin-top: 0;
    margin-bottom: var(--cx-space-2);
  }
  .demo-panel {
    max-width: 44rem;
    margin-top: var(--cx-space-5);
    padding: clamp(1rem, 4vw, 1.75rem);
    background: var(--cx-surface);
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-lg);
  }
  .demo-panel :global(.demo-controls > *) {
    min-width: 0;
  }
  .demo-panel :global(.demo-controls) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-6);
  }
  .demo :global(.demo-grid) {
    display: grid;
    gap: var(--cx-space-6);
    align-items: start;
  }
  .demo :global(.demo-grid > *) {
    min-width: 0;
  }
  @media (min-width: 60rem) {
    .demo :global(.demo-grid) {
      grid-template-columns: 7fr 5fr;
    }
  }
  #tabulka :global(.cx-table) {
    max-width: 48rem;
  }
  .chips {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(11rem, 100%), 1fr));
    gap: var(--cx-space-4);
    margin: var(--cx-space-5) 0;
    padding: 0;
    list-style: none;
  }
  .chip {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .chip__sw {
    display: flex;
    height: 3.5rem;
    border-radius: var(--cx-radius-sm);
    overflow: hidden;
    border: 1px solid var(--cx-line);
    margin-bottom: 0.4rem;
  }
  .chip__sw i {
    flex: 1;
  }
  .chip__name {
    font-weight: 600;
    font-size: var(--cx-fs-small);
  }
  .chip__hex {
    color: var(--cx-muted);
    font-size: var(--cx-fs-small);
  }
</style>
