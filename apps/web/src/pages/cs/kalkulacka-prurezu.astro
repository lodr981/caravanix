---
// Kalkulačka průřezu a pojistky (verze 1.1). PRACOVNÍ VERZE pro lokální alfu: texty a karty zatím nejsou schválené,
// stránka má noindex a výrazný štítek. Čísla počítá výhradně engine.
import Zaklad from "../../layouts/Zaklad.astro";
import { KalkulackaPrurezu } from "../../components/KalkulackaPrurezu.tsx";
import { referencniTabulka } from "@caravanix/engine";
import { DataTable, Notice, formatDecimal } from "@caravanix/ui";
import { getCollection } from "astro:content";
import t from "../../../../../content/cs/kalkulacka-prurezu.json";

const NBSP = " ";
const f = (x: number, d = 1) => formatDecimal(x, d).replace(/ /g, NBSP);
const lekce = (await getCollection("lekceCs"))
  .filter((l) => l.data.kalkulacka === "/cs/kalkulacka-prurezu/")
  .sort((a, b) => a.data.poradi - b.data.poradi);
const radky = referencniTabulka().map((r) => ({
  prurez: `${f(r.prurez, 2)}${NBSP}mm²`,
  awg: `${r.awg.oznaceni} (${f(r.awg.plocha, 2)})`,
  n: `${f(r.maxPojistka)}${NBSP}A`,
  h: `${f(r.maxPojistkaSvazek)}${NBSP}A`,
  d3: `${f(r.delka3)}${NBSP}m`,
  d10: `${f(r.delka10)}${NBSP}m`,
}));
---

<Zaklad title={t["page.title"]} description={t["page.description"]} noindex>
  <section class="cx-wrap kp-uvod">
    <Notice kind="warn" word={t["draft.word"]}>
      <p>{t["draft.text"]}</p>
    </Notice>
    <h1>{t["page.h1"]}</h1>
    <p class="cx-lead cx-muted">{t["page.lead"]}</p>
  </section>

  <section class="cx-wrap">
    <KalkulackaPrurezu client:load t={t} />
  </section>

  <section class="cx-wrap kp-dalsi">
    <h2>{t["how.h2"]}</h2>
    <ol>
      <li>{t["how.1"]}</li>
      <li>{t["how.2"]}</li>
      <li>{t["how.3"]}</li>
      <li>{t["how.4"]}</li>
      <li>{t["how.5"]}</li>
    </ol>

    {
      lekce.length > 0 && (
        <>
          <h2>{t["lekce.h2"]}</h2>
          <ul class="cx-linklist kp-lekce">
            {lekce.map((l) => (
              <li>
                <a class="cx-linklist__link" href={`/cs/lekce/${l.id}/`}>{l.data.titulek}</a>
                <p class="cx-linklist__text">{l.data.zasada}</p>
              </li>
            ))}
          </ul>
        </>
      )
    }

    <h2>{t["tab.h2"]}</h2>
    <DataTable
      caption={t["tab.caption"]}
      rowHeader="prurez"
      columns={[
        { key: "prurez", header: t["tab.prurez"] },
        { key: "awg", header: t["tab.awg"] },
        { key: "n", header: t["tab.n"], numeric: true },
        { key: "h", header: t["tab.h"], numeric: true },
        { key: "d3", header: t["tab.d3"], numeric: true },
        { key: "d10", header: t["tab.d10"], numeric: true },
      ]}
      rows={radky}
      note={t["tab.note"]}
    />
  </section>
</Zaklad>

<style is:global>
  .kp-uvod {
    padding-block: var(--cx-space-7) var(--cx-space-5);
  }
  .kp-uvod h1 {
    margin-block: var(--cx-space-5) var(--cx-space-3);
  }
  .kp {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-6);
    align-items: start;
  }
  @media (min-width: 1024px) {
    .kp {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .kp-vysledek {
      position: sticky;
      top: var(--cx-space-5);
    }
  }
  .kp-form {
    display: grid;
    gap: var(--cx-space-5);
  }
  /* Posuvník a pole délky v metrech patří k sobě: menší mezera než mezi ostatními poli. */
  .kp-delka {
    display: grid;
    gap: var(--cx-space-3);
    min-width: 0;
  }
  .kp-vysledek {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--cx-space-4);
  }
  .kp-det {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--cx-space-2) var(--cx-space-4);
    margin: var(--cx-space-4) 0 0;
  }
  .kp-det dt {
    opacity: 0.85;
  }
  .kp-det dd {
    margin: 0;
    text-align: right;
    font-weight: 600;
  }
  /* 360 px při 200% zvětšení: popisek a hodnota pod sebou, nic nepřetéká */
  @media (max-width: 20rem) {
    .kp-det {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .kp-det dd {
      text-align: left;
      margin-bottom: var(--cx-space-2);
    }
  }
  .kp-dalsi {
    padding-block: var(--cx-space-7);
  }
  .kp-dalsi h2 {
    margin-bottom: var(--cx-space-4);
  }
  .kp-lekce {
    margin-bottom: var(--cx-space-7);
  }
  .kp-dalsi ol {
    padding-left: 1.4em;
    margin-bottom: var(--cx-space-7);
    max-width: 40em;
  }
  .kp-dalsi ol li + li {
    margin-top: var(--cx-space-2);
  }
  .kp-souhrn {
    margin: 0;
  }
  .kp-souhrn a {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--cx-space-2) var(--cx-space-4);
    min-height: 48px;
    align-items: center;
    padding: var(--cx-space-3) var(--cx-space-4);
    border: 1px solid var(--cx-line);
    border-radius: var(--cx-radius-md);
    background: var(--cx-surface);
    color: var(--cx-text);
    font-weight: 600;
    text-decoration: none;
  }
  .kp-souhrn-odkaz {
    color: var(--cx-accent-text, var(--cx-accent));
    text-decoration: underline;
  }
  @media (min-width: 1024px) {
    .kp-souhrn {
      display: none;
    }
  }
  .kp-chyba-nadpis {
    margin: 0;
  }
  .kp-vysledek {
    scroll-margin-top: var(--cx-space-5);
  }
  .kp-listek {
    border: 1px dashed var(--cx-border);
    border-radius: var(--cx-radius-md);
    /* Boční odsazení se při úzkém okně (200% zvětšení) zmenší jako u karty výsledku. */
    padding: var(--cx-space-4) clamp(var(--cx-space-3), 3.5vw, var(--cx-space-5));
    background: var(--cx-surface);
    min-width: 0;
    display: grid;
    gap: var(--cx-space-3);
  }
  .kp-listek h2 {
    margin: 0;
    font-size: var(--cx-fs-h3);
  }
  .kp-listek ul {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: var(--cx-space-2);
  }
  /* Tlačítka sdílení ve výsledku: po zalomení stejně široká, ne dvě různé délky pod sebou. */
  .kp-vysledek .cx-result .cx-btns > .cx-btn {
    flex: 1 1 15rem;
  }
  @media print {
    body * {
      visibility: hidden;
    }
    .kp-listek,
    .kp-listek * {
      visibility: visible;
    }
    /* Skrytý obsah by jinak dál zabíral místo a tiskly by se prázdné stránky. */
    body *:not(:has(.kp-listek)):not(.kp-listek):not(.kp-listek *) {
      display: none;
    }
    .kp-listek {
      position: absolute;
      inset: 0 auto auto 0;
      border: 0;
    }
    .kp-listek .cx-btns {
      display: none;
    }
  }
</style>
